[Please]
version = 17.27.0

[Build]
path = /opt/rust-rules/toolchain/1.0/bin/:/bin:/usr/bin:/usr/local/bin
timeout = 2000

[Plugin "rust"]
Target = //plugins:rust
Rustc = //third_party/rust:toolchain_rustc
StdLib = //third_party/rust:toolchain_stdlib
RepoRoot = //third_party/rust:toolchain_target
; Exercise the pipelined shape in this repo; consumers default to off
PipelinedCompilation = true

[Parse]
preloadsubincludes = ///proto//build_defs:proto
preloadsubincludes = ///shell//build_defs:shell
preloadsubincludes = ///python//build_defs:python
preloadbuilddefs = build_defs/rust_toolchain.build_defs
preloadbuilddefs = build_defs/rust.build_defs
preloadbuilddefs = build_defs/rust_crate.build_defs
preloadbuilddefs = build_defs/rust_repo.build_defs

[Plugin "shell"]
Target = //plugins:shell

[Plugin "cc"]
Target = //plugins:cc

[Plugin "proto"]
Target = //plugins:proto
ProtocTool = //third_party/proto:protoc
LanguageDef = //build_defs/proto:rust_proto_lang

[Plugin "python"]
Target = //plugins:python
DefaultInterpreter = python3

[PluginDefinition]
Name = rust

[PluginConfig "rustc"]
DefaultValue = //third_party/rust:toolchain_rustc
Help = A file path or build label for rustc.
Inherit = true

[PluginConfig "stdlib"]
DefaultValue = //third_party/rust:toolchain_stdlib
Help = A file path or build label for a rust stdlib.
Inherit = true
Optional = true

[PluginConfig "repo_root"]
DefaultValue = //third_party/rust:toolchain_target
Help = An absolute filepath of the repo root. Used for linking external dependencies.
Inherit = true
Optional = true

[alias "rustc"]
Desc = Runs the rustc binary and sets required env vars.
Cmd = run //scripts:rustc
Flag = ["--version", "-vV", "--explain"]

[alias "cargo"]
Desc = Runs the cargo binary and sets required env vars.
Cmd = run //scripts:cargo
Subcommand = ["build", "test", "run", "clean", "check", "new", "rustc"]
Flag = ["--release", "--verbose", "--manifest-path"]
PositionalLabels = true

[alias "cargo-nightly"]
Desc = Runs the cargo binary and sets required env vars.
Cmd = run //scripts:cargo_nightly
Subcommand = ["build", "test", "run", "clean", "check", "new", "rustc"]
Flag = ["--release", "--verbose", "--manifest-path", "-Z"]
PositionalLabels = true

[PluginConfig "proto_plugin"]
ConfigKey = ProtoPlugin
DefaultValue = ///third_party/rust/protoc_gen_prost//:protoc_gen_prost_bin
Inherit = true

[PluginConfig "grpc_plugin"]
ConfigKey = GrpcPlugin
DefaultValue = ///third_party/rust/protoc_gen_tonic//:protoc_gen_tonic_bin
Inherit = true

[PluginConfig "proto_dep"]
ConfigKey = ProtoDep
DefaultValue = //third_party/rust:prost
Inherit = true

[PluginConfig "grpc_dep"]
ConfigKey = GrpcDep
DefaultValue = //third_party/rust:tonic
Inherit = true

[PluginConfig "please_rust_tool"]
ConfigKey = PleaseRustTool
DefaultValue = //tools/please_rust:bootstrap
Help = Build label of the please_rust tool used to generate and compile crates.
Inherit = true

[PluginConfig "sysroot"]
ConfigKey = Sysroot
DefaultValue = //third_party/rust:toolchain_sysroot
Help = A build label for the Rust sysroot (contains lib/rustlib/...).
Inherit = true

[PluginConfig "cc_tool"]
ConfigKey = CCTool
DefaultValue = 
Optional = true
Help = Optional build label of a C compiler used by crate build scripts and as rustc's linker (the go-rules CC_TOOL pattern). Empty uses the host cc via PATH, matching the cc plugin's default.
Inherit = true

[PluginConfig "default_static"]
ConfigKey = DefaultStatic
DefaultValue = true
Type = bool
Help = Statically link the C runtime into rust_binary outputs by default, producing self-contained binaries like Go's.
Inherit = true

[Plugin "e2e"]
Target = //plugins:e2e
PleaseVersion = 17.27.0

[PluginConfig "llvm_tools"]
ConfigKey = LlvmTools
DefaultValue = //third_party/rust:toolchain_llvm_tools
Help = Build label of the llvm-tools directory (llvm-profdata, llvm-cov) used for coverage.
Inherit = true

; plz only aggregates coverage for known file extensions; .rs is not in its
; default list. Consuming repos need this too (documented in the README).
[cover]
fileextension = .rs

[PluginConfig "pipelined_compilation"]
ConfigKey = PipelinedCompilation
DefaultValue = false
Type = bool
Help = Split each crate into a metadata-only compile that dependents hang off plus a parallel full compile (the rules_rust two-action scheme). Dependency chains build at frontend depth; the frontend runs twice per crate.
Inherit = true

[PluginConfig "clippy_tool"]
ConfigKey = ClippyTool
DefaultValue = //third_party/rust:toolchain_clippy
Help = Build label of clippy-driver (a rustc-compatible frontend) used by rust_clippy.
Inherit = true

[PluginConfig "rustfmt_tool"]
ConfigKey = RustfmtTool
DefaultValue = //third_party/rust:toolchain_rustfmt
Help = Build label of rustfmt, used by rust_fmt_test.
Inherit = true

[PluginConfig "bindgen_tool"]
ConfigKey = BindgenTool
DefaultValue = ///third_party/rust/bindgen_cli//:bindgen_bin
Help = Build label of the bindgen binary used by rust_bindgen. Built from crates via rust_repo (bindgen-cli).
Inherit = true

[PluginConfig "libclang_path"]
ConfigKey = LibclangPath
DefaultValue = 
Optional = true
Help = Directory containing libclang.so for rust_bindgen. Empty uses clang-sys's runtime search of standard host locations, matching the host-cc convention.
Inherit = true

[PluginConfig "opt_level"]
ConfigKey = OptLevel
DefaultValue = 
Optional = true
Help = rustc -C opt-level for the opt config (0-3, s, z). Empty uses -O, which is opt-level 2.
Inherit = true

[PluginConfig "lto"]
ConfigKey = LTO
DefaultValue = 
Optional = true
Help = rustc -C lto for the opt config (thin, fat, off). Empty leaves rustc's default.
Inherit = true

[PluginConfig "codegen_units"]
ConfigKey = CodegenUnits
DefaultValue = 
Optional = true
Help = rustc -C codegen-units. Fewer units optimise better and build slower.
Inherit = true

[PluginConfig "panic"]
ConfigKey = Panic
DefaultValue = 
Optional = true
Help = rustc -C panic for the opt config (unwind, abort). Empty leaves rustc's default (unwind).
Inherit = true

[PluginConfig "strip"]
ConfigKey = Strip
DefaultValue = 
Optional = true
Help = rustc -C strip for the opt config (none, debuginfo, symbols).
Inherit = true

[PluginConfig "debug_assertions"]
ConfigKey = DebugAssertions
DefaultValue = 
Optional = true
Help = rustc -C debug-assertions (true/false). Empty follows the build config.
Inherit = true
