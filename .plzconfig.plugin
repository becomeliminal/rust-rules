; The config consumers of this plugin see (exported as .plzconfig by
; //test:export and used by plugin releases). Dev-only config lives in
; .plzconfig, which must keep these sections in sync (the e2e test catches
; drift).

[PluginDefinition]
Name = rust

[PluginConfig "rustc"]
DefaultValue = //third_party/rust:toolchain_rustc|rustc
Help = A file path or build label for rustc.
Inherit = true

[PluginConfig "stdlib"]
DefaultValue = //third_party/rust:toolchain_stdlib
Help = A file path or build label for a rust stdlib.
Inherit = true
Optional = true

[PluginConfig "please_rust_tool"]
ConfigKey = PleaseRustTool
DefaultValue = //tools/please_rust:please_rust_release
Help = Build label of the please_rust tool used to generate and compile crates. Defaults to a hash-pinned release download, which needs no toolchain, no cargo and no network beyond the fetch itself. //tools/please_rust:bootstrap builds it from source instead, at the cost of a cargo build that does not work under remote execution.
Inherit = true

[PluginConfig "sysroot"]
ConfigKey = Sysroot
DefaultValue = //third_party/rust:toolchain_sysroot
Help = A build label for the Rust sysroot (contains lib/rustlib/...).
Inherit = true

[PluginConfig "cc_tool"]
ConfigKey = CCTool
DefaultValue = 
Optional = true
Help = Optional build label of a C compiler used by crate build scripts and as rustc's linker (the go-rules CC_TOOL pattern). Empty uses the host cc via PATH, matching the cc plugin's default.
Inherit = true

[PluginConfig "default_static"]
ConfigKey = DefaultStatic
DefaultValue = true
Type = bool
Help = Statically link the C runtime into rust_binary outputs by default, producing self-contained binaries like Go's.
Inherit = true

[PluginConfig "llvm_tools"]
ConfigKey = LlvmTools
DefaultValue = //third_party/rust:toolchain_llvm_tools
Help = Build label of a directory holding the llvm tools as bin/ and lib/ (llvm-cov resolves libLLVM through ../lib). Used only by plz cover.
Inherit = true

[PluginConfig "pipelined_compilation"]
ConfigKey = PipelinedCompilation
DefaultValue = false
Type = bool
Help = Split each crate into a metadata-only compile that dependents hang off plus a parallel full compile (the rules_rust two-action scheme). Dependency chains build at frontend depth; the frontend runs twice per crate.
Inherit = true

[PluginConfig "clippy_tool"]
ConfigKey = ClippyTool
DefaultValue = //third_party/rust:toolchain_rustc|clippy
Help = Build label of clippy-driver (a rustc-compatible frontend) used by rust_clippy.
Inherit = true

[PluginConfig "rustfmt_tool"]
ConfigKey = RustfmtTool
DefaultValue = //third_party/rust:toolchain_rustc|rustfmt
Help = Build label of rustfmt, used by rust_fmt_test.
Inherit = true

[PluginConfig "bindgen_tool"]
ConfigKey = BindgenTool
DefaultValue = ///third_party/rust/bindgen_cli//:bindgen_bin
Help = Build label of the bindgen binary used by rust_bindgen. Built from crates via rust_repo (bindgen-cli).
Inherit = true

[PluginConfig "libclang_path"]
ConfigKey = LibclangPath
DefaultValue = 
Optional = true
Help = Directory containing libclang.so for rust_bindgen. Empty uses clang-sys's runtime search of standard host locations, matching the host-cc convention.
Inherit = true

[PluginConfig "opt_level"]
ConfigKey = OptLevel
DefaultValue = 
Optional = true
Help = rustc -C opt-level for the opt config (0-3, s, z). Empty uses -O, which is opt-level 2.
Inherit = true

[PluginConfig "lto"]
ConfigKey = LTO
DefaultValue = 
Optional = true
Help = rustc -C lto for the opt config (thin, fat, off). Empty leaves rustc's default.
Inherit = true

[PluginConfig "target_triple"]
ConfigKey = TargetTriple
DefaultValue = 
Optional = true
Help = The Rust target triple to build for, named verbatim instead of derived from --arch. Please's os_arch pair cannot express wasm32-unknown-unknown, sbf-solana-solana or any musl target, and those fail at parse time without this. Empty derives the triple from --arch as before.
Inherit = true

[PluginConfig "build_script_jobs"]
ConfigKey = BuildScriptJobs
DefaultValue = 
Optional = true
Help = NUM_JOBS for build scripts. cc-rs and cmake-rs read it to decide how many C compilers to run, so a -sys crate with a vendored C tree builds at this width. Empty uses half the machine, because plz is already running other actions alongside it.
Inherit = true

[PluginConfig "codegen_units"]
ConfigKey = CodegenUnits
DefaultValue = 
Optional = true
Help = rustc -C codegen-units. Fewer units optimise better and build slower.
Inherit = true

[PluginConfig "panic"]
ConfigKey = Panic
DefaultValue = 
Optional = true
Help = rustc -C panic for the opt config (unwind, abort). Empty leaves rustc's default (unwind).
Inherit = true

[PluginConfig "strip"]
ConfigKey = Strip
DefaultValue = 
Optional = true
Help = rustc -C strip for the opt config (none, debuginfo, symbols).
Inherit = true

[PluginConfig "debug_assertions"]
ConfigKey = DebugAssertions
DefaultValue = 
Optional = true
Help = rustc -C debug-assertions (true/false). Empty follows the build config.
Inherit = true

[PluginConfig "criterion_dep"]
ConfigKey = CriterionDep
DefaultValue = //third_party/rust:criterion
Help = The criterion crate that rust_benchmark rules link against.
Inherit = true

[PluginConfig "cargo_tool"]
ConfigKey = CargoTool
DefaultValue = //third_party/rust:toolchain_cargo|cargo
Optional = true
Help = Cargo from the toolchain, used only by the bootstrap that breaks the egg (nothing else runs cargo). It is a target of its own so that compiling Rust never stages it.
Inherit = true

[PluginConfig "local_subrepos"]
ConfigKey = LocalSubrepos
DefaultValue = true
Type = bool
Help = Run crate download and BUILD generation locally rather than on a remote worker. These steps fetch a tarball and write BUILD files, so there is little to gain remotely, and Please crashes reading a remote subrepo's config when its tree is not in the remote cache.
Inherit = true



[PluginConfig "project_script"]
ConfigKey = ProjectScript
DefaultValue = //build_defs:project_script
Help = The discovery script behind rust_project. Internal to the plugin; a consumer has no reason to set it.
Inherit = true
