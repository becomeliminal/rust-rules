"""Rust build rules for the Please build system.

One file, the way go-rules keeps go.build_defs one file. Please gives each
.build_defs its own scope - a function defined in one cannot call a function
defined in another, even when a filegroup loads them together - so splitting
these meant a plugin-internal subinclude for every shared helper. go-rules
splits only where a rule needs a different plugin entirely, which nothing
here does.

Rules compile via `please_rust compile`, the same driver the BUILD files that
rust_repo generates for third-party subrepos use. Dependency wiring works by
aggregation: every library rule outputs a `<crate>.externconfig` mapping crate
name -> rlib filename. A dependent collects every externconfig in its
(transitive) inputs, and please_rust resolves each entry to an on-disk path
and passes `--extern name=path` to rustc. This makes first-party rules and
rust_repo subrepo crates freely interoperable in either direction.
"""

RUST_OSES = {
    'linux': 'unknown-linux-gnu',
    'darwin': 'apple-darwin',
}

# Please's architecture names on the left, the Rust target triple's on the right
RUST_ARCHES = {
    'amd64': 'x86_64',
    'x86': 'i686',
    'arm64': 'aarch64',
    'arm': 'arm',
}


def rust_triple(plz_os:str, plz_arch:str, context:str='rust_toolchain'):
    """The Rust target triple for one of Please's os_arch pairs."""
    os = RUST_OSES.get(plz_os, '')
    arch = RUST_ARCHES.get(plz_arch, '')
    if not os or not arch:
        raise ParseError('Unknown platform %s_%s, pass its triple explicitly to %s' % (plz_os, plz_arch, context))
    return '%s-%s' % (arch, os)


def host_triple():
    """The triple of the machine doing the building."""
    return rust_triple(CONFIG.HOSTOS, CONFIG.HOSTARCH, 'rust_toolchain')


def target_triple(context:str='rust'):
    """The triple being built for.

    Normally derived from what `--arch` names, the same way rust_toolchain
    derives its download URL. But Please's model is an os_arch pair, and Rust
    has targets that pair cannot express: `wasm32-unknown-unknown` is neither
    an OS nor an architecture Please knows, `sbf-solana-solana` is neither,
    and a musl target needs a libc dimension Please does not have at all.
    Those used to fail at parse time, before anything could build.

    `TargetTriple` names one verbatim and skips the derivation. Unset, this is
    exactly what the two hardcoded copies of the os/arch tables did before.
    """
    if CONFIG.RUST.TARGET_TRIPLE:
        return CONFIG.RUST.TARGET_TRIPLE
    return rust_triple(CONFIG.TARGET_OS, CONFIG.TARGET_ARCH, context)


def rust_toolchain(name:str, version:str, os=None, arch=None, hashes=None, deps=None, visibility=None, nightly=False,
                   architectures:list=[], std_hashes:dict={}, src_hash:str=None):
    """Defines rules to fetch a Rust toolchain.

    Typically you'd set the name of this rule into rustc_toolchain, either in your .plzconfig
    or using package(). rustc and the stdlib will then be automatically derived from it.

    Args:
      name (str): Name of the rule.
      version (str): Version of Rust to download.
      os (str): Operating system to download for, as the full triple, e.g. 'unknown-linux-gnu', 'pc-windows-msvc', etc.
                Defaults to the host OS, as best we can.
      arch (str): Architecture to download for, e.g. 'i686' or 'x86_64'. Defaults to the host one.
      hashes (list) List of hashes to verify on download.
      deps (list): Extra dependencies of the rule.
      visibility (list): Visibility declaration of the rule.
      architectures (list): Additional platforms to install the standard library for, either in
                            Please's format e.g. 'darwin_arm64', or as a Rust triple e.g.
                            'wasm32-unknown-unknown' for targets Please's os_arch pair cannot
                            express. The platform passed to --arch is installed automatically;
                            listing others here is for cross-compiling part of a repo by hand,
                            and is how a TargetTriple target gets its standard library.
      std_hashes (dict): Hashes for those standard libraries, keyed the same way as architectures.
      src_hash (str): Hash of the rust-src component, which carries the standard library's own
                      sources. Only `<name>_sysroot_src` fetches it, and only rust-analyzer
                      needs that, so a repo not generating a rust-project.json never downloads it.
    """
    # rustc runs on the machine doing the building whatever it is compiling for,
    # so the toolchain is downloaded for the host and cross-compilation is a
    # matter of which standard libraries sit in its sysroot.
    if not os:
        os = RUST_OSES.get(CONFIG.HOSTOS, '')
        if not os:
            raise ParseError('Unknown OS %s, you must pass os explicitly to rust_toolchain' % CONFIG.HOSTOS)
    if not arch:
        arch = RUST_ARCHES.get(CONFIG.HOSTARCH, '')
        if not arch:
            raise ParseError('Unknown architecture %s, you must pass arch explicitly to rust_toolchain' % CONFIG.HOSTARCH)

    base = '-'.join(['rust', version, arch, os])
    triple = '%s-%s' % (arch, os)

    if CONFIG.TARGET_OS != CONFIG.HOSTOS or CONFIG.TARGET_ARCH != CONFIG.HOSTARCH:
        architectures += ['%s_%s' % (CONFIG.TARGET_OS, CONFIG.TARGET_ARCH)]
    # A TargetTriple names a platform --arch cannot, so it needs the same
    # treatment: fetched when it is what you are building for, and not
    # otherwise. Listing one in `architectures` instead would put its standard
    # library in the sysroot of every build - wasm32's is 93M, against 162M
    # for the host's, and the sysroot is staged by every compile.
    if CONFIG.RUST.TARGET_TRIPLE and CONFIG.RUST.TARGET_TRIPLE != triple:
        architectures += [CONFIG.RUST.TARGET_TRIPLE]
    download_rule = remote_file(
        name = '_%s#download' % name,
        url = 'https://static.rust-lang.org/dist/%s.tar.gz' % base,
        #key = 'https://static.rust-lang.org/rust-key.gpg.ascii',
        hashes = hashes,
        deps = deps,
    )
    # One rule, one directory, entry points into it - the shape go_toolchain
    # uses. Everything the toolchain provides lives inside a single output, so
    # an action cannot stage a binary without the libraries sitting beside it.
    # Exposing rustc, rustdoc and the llvm tools as separate targets made that
    # separation possible, and it happened: each of them loads a library from
    # ../lib relative to its own binary, which survives locally (where the
    # extracted tree is all present) and not on a remote worker (which stages
    # only what an action names).
    #
    # clippy-driver and rustfmt resolve librustc_driver the same way, so they
    # move next to rustc rather than being copied out into rules of their own.
    llvm_bin = '%s/llvm-tools-preview/lib/rustlib/%s/bin' % (name, triple)
    sysroot = '%s/rust-std-%s' % (name, triple)

    # A standard library for another platform goes into this same sysroot,
    # under its own triple, which is where rustc --target looks for it. One
    # sysroot serving every target is what rustup produces too, and it keeps
    # cross-compiling to a matter of passing --target.
    std_rules = []
    std_cmds = []
    for plat in architectures:
        # A Please os_arch pair, or a Rust triple named verbatim for the
        # targets that pair cannot express - wasm32-unknown-unknown is
        # neither an OS nor an architecture Please knows, and musl needs a
        # libc dimension it does not have. Triples contain a hyphen and
        # os_arch pairs do not, which is what tells them apart.
        if '-' in plat:
            plat_triple = plat
        else:
            plat_os, _, plat_arch = plat.partition('_')
            plat_triple = rust_triple(plat_os, plat_arch)
        if plat_triple == triple:
            continue
        std_base = 'rust-std-%s-%s' % (version, plat_triple)
        std_rules += [remote_file(
            name = '_%s#std_%s' % (name, plat),
            url = 'https://static.rust-lang.org/dist/%s.tar.gz' % std_base,
            hashes = [std_hashes[plat]] if plat in std_hashes else None,
        )]
        std_cmds += [
            'mv %s/rust-std-%s/lib/rustlib/%s $OUT/rust-std-%s/lib/rustlib/' % (std_base, plat_triple, plat_triple, triple),
        ]

    extract = ['for f in $SRCS_STD; do tar -xzf $f; done'] if std_rules else []
    # Build the output from a keep-list rather than extracting everything and
    # deleting what we do not want. Same reason either way - the dist ships
    # 887M of HTML documentation, and this output is one directory so that a
    # binary cannot be staged without the libraries beside it, which means
    # every action naming an entry point takes the whole tree as an input.
    # Locally that is free; on a remote executor it is a Merkle tree to hash,
    # upload and materialise per worker. rust-docs alone is 65,529 of the
    # 65,735 files in a full extraction.
    #
    # Selecting is preferred over deleting because what lands in $OUT is then
    # stated rather than implied: no glob decides it, and a component the dist
    # adds later cannot quietly start riding along.
    cmds = [
        'tar -xzf $SRCS_DIST',
    ] + extract + [
        'mkdir $OUT',
        'mv {b}/rustc {b}/cargo {b}/rust-std-{t} {b}/llvm-tools-preview $OUT/'.format(b = base, t = triple),
        # clippy-driver and rustfmt resolve librustc_driver relative to their
        # own binary, so they move next to rustc rather than keeping the
        # components they ship in.
        'mv %s/clippy-preview/bin/clippy-driver $OUT/rustc/bin/' % base,
        'mv %s/rustfmt-preview/bin/rustfmt $OUT/rustc/bin/' % base,
        # rustc's own component carries 16M of licence HTML.
        'rm -rf $OUT/rustc/share/doc',
    ] + std_cmds

    toolchain = build_rule(
        name = name,
        srcs = {'dist': [download_rule], 'std': std_rules},
        outs = [name],
        cmd = ' && '.join(cmds),
        # Files only. A non-empty directory cannot be an entry point under
        # remote execution: plz validates every declared entry point by
        # membership in the flattened action outputs, and flattening keys
        # files, symlinks and empty directories - a non-empty directory's own
        # path is never a key, so the check cannot succeed. Locally plz stats
        # the path and a directory stats fine, which is why this is invisible
        # until a worker runs it.
        #
        # A whole output that *is* the directory works, which is what the
        # sysroot rule below is. Note the check runs over every declared entry
        # point whether or not anything uses it, so a directory entry point
        # left here for compatibility would keep failing the target.
        entry_points = {
            'rustc': '%s/rustc/bin/rustc' % name,
            'rustdoc': '%s/rustc/bin/rustdoc' % name,
            'clippy': '%s/rustc/bin/clippy-driver' % name,
            'rustfmt': '%s/rustc/bin/rustfmt' % name,
            'cargo': '%s/cargo/bin/cargo' % name,
            'llvm-cov': '%s/llvm-cov' % llvm_bin,
            'llvm-profdata': '%s/llvm-profdata' % llvm_bin,
        },
        binary = True,
        building_description = 'Extracting...',
        visibility = visibility,
    )

    # The standard library's own sources, which rust-analyzer needs for
    # go-to-definition into std and cannot get from the rlibs. Its own
    # download and its own target: nothing but `please_rust ide` wants it, so
    # a repo that never generates a rust-project.json never fetches it. Not
    # triple-specific, and 8.7MB against the distribution's 800.
    src_download = remote_file(
        name = '_%s#src' % name,
        url = 'https://static.rust-lang.org/dist/rust-src-%s.tar.gz' % version,
        hashes = [src_hash] if src_hash else None,
    )
    build_rule(
        name = '%s_sysroot_src' % name,
        srcs = [src_download],
        outs = ['rust-src'],
        # rust-analyzer wants the `library` directory itself, which is what
        # sysroot_src names in a rust-project.json.
        cmd = 'tar -xzf $SRCS && mv rust-src-%s/rust-src/lib/rustlib/src/rust/library $OUT' % version,
        output_is_complete = True,
        visibility = visibility,
    )

    # The compiler, extracted so that an action naming rustc does not stage
    # the whole distribution behind it. This is go-rules' shape: go_toolchain
    # keeps its entry points and each hot tool is also lifted into a target of
    # its own with output_is_complete, which is what severs the dependency.
    #
    # bin and lib together and never apart: rustc resolves librustc_driver
    # through ../lib relative to its own binary, so a target holding only the
    # binaries stages a compiler that cannot start. clippy-driver and rustfmt
    # were moved next to rustc above for the same reason, which is also why
    # all four entry points have to live on this one target - toolchain_entry
    # derives its siblings from whatever Rustc points at.
    build_rule(
        name = '%s_rustc' % name,
        srcs = [toolchain],
        outs = ['rustc'],
        cmd = 'mv $SRCS/rustc $OUT',
        entry_points = {
            'rustc': 'rustc/bin/rustc',
            'rustdoc': 'rustc/bin/rustdoc',
            'clippy': 'rustc/bin/clippy-driver',
            'rustfmt': 'rustc/bin/rustfmt',
        },
        binary = True,
        output_is_complete = True,
        visibility = visibility,
    )

    # Only the from-source bootstrap runs cargo, so nothing that compiles Rust
    # should be staging it.
    build_rule(
        name = '%s_cargo' % name,
        srcs = [toolchain],
        outs = ['cargo'],
        cmd = 'mv $SRCS/cargo $OUT',
        entry_points = {'cargo': 'cargo/bin/cargo'},
        binary = True,
        output_is_complete = True,
        visibility = visibility,
    )

    # rustc wants a directory, so the directory is the whole output. Splitting
    # it out is safe in a way that splitting rustc is not: a sysroot is rlibs
    # and rmeta, with no binary resolving its libraries through ../lib.
    build_rule(
        name = '%s_sysroot' % name,
        srcs = [toolchain],
        outs = ['rust-std-%s' % triple],
        cmd = 'mv $SRCS/rust-std-%s $OUT' % triple,
        # Without this a consumer inherits the toolchain behind it, which is
        # the whole point of splitting it out.
        output_is_complete = True,
        visibility = visibility,
    )

    # bin and lib together, because llvm-cov resolves libLLVM through
    # $ORIGIN/../lib: an output of the bin directory alone would stage a binary
    # that cannot start. Consumers point the coverage tools at its bin subdir.
    build_rule(
        name = '%s_llvm_tools' % name,
        srcs = [toolchain],
        outs = ['llvm-tools'],
        cmd = 'mv $SRCS/llvm-tools-preview/lib/rustlib/%s $OUT' % triple,
        output_is_complete = True,
        visibility = visibility,
    )

    return toolchain


def _rustdoc_tools():
    """Tools for rustdoc actions. rustdoc is an entry point of the same
    toolchain target as rustc, so it arrives with the libraries it loads."""
    return {
        'please_rust': [CONFIG.RUST.PLEASE_RUST_TOOL],
        'rustdoc': [toolchain_entry('rustdoc')],
        'sysroot': [CONFIG.RUST.SYSROOT],
    }


def target_flag(crate_type:str=''):
    """`--target` when building for a platform other than the host.

    rustc runs on the host whatever it compiles for, so cross-compiling is a
    matter of naming the target and having its standard library in the
    sysroot; `rust_toolchain(architectures = [...])` puts one there, and the
    platform passed to `--arch` is installed without being listed.

    Proc macros are loaded into rustc itself, so they are compiled for the
    host even when everything around them is not. Cargo does the same.

    Comparing triples rather than os_arch pairs so that `TargetTriple` set to
    the host's own triple produces exactly what deriving it does - which is
    the property the test for it asserts.
    """
    if crate_type == 'proc-macro':
        return ''
    target = target_triple('rust_library')
    if target == host_triple():
        return ''
    return '--target %s ' % target


def _dylib_ext(host:bool=False):
    """The dynamic library extension of the target, or of the host for
    artifacts that run during the build rather than after it."""
    os = CONFIG.HOSTOS if host else CONFIG.TARGET_OS
    return '.dylib' if os == 'darwin' else '.so'


def toolchain_entry(entry:str):
    """Another entry point of whatever toolchain target rustc comes from.

    Every tool the toolchain provides is an entry point of one target, so
    naming rustc names them all. Deriving them keeps a consumer from having
    to configure each, and keeps a plugin's own default from sending them to
    its toolchain instead of theirs: Please qualifies a plugin's DefaultValue
    into that plugin's subrepo.
    """
    rustc = CONFIG.RUST.RUSTC
    if '|' not in rustc:
        return ''
    return rustc.split('|')[0] + '|' + entry


def _rust_tools(link:bool=False):
    # Evaluated at rule-call time; plugin config is not available when the
    # build defs are preloaded.
    tools = {
        "please_rust": [CONFIG.RUST.PLEASE_RUST_TOOL],
        "rustc": [CONFIG.RUST.RUSTC],
        "sysroot": [CONFIG.RUST.SYSROOT],
    }
    if link and CONFIG.RUST.CC_TOOL:
        tools["cc"] = [CONFIG.RUST.CC_TOOL]
    return tools

# Collects externconfig files from all transitive inputs into one file for
# please_rust compile. The aggregate is named `externconfig` (no extension) so
# the find does not pick it up itself.
_AGGREGATE_EXTERNCONFIGS = "find . -name '*.externconfig' -type f 2>/dev/null | xargs cat >> externconfig 2>/dev/null || true"


def _dep_names(deps:list):
    """The declarations of the direct deps, for --extern filtering.

    A dep names the declaration it wants and nothing else. It cannot name the
    crate, because a label carries the *package* name and a crate that sets
    `[lib] name` is not called that: rustls-webpki builds webpki, md-5 builds
    md5. Nor can it derive the crate by stripping a version off the label,
    because a version is not a single hyphenated part: toml 1.1.4+spec-1.1.0
    is declared `toml-1.1.4+spec-1.1.0`. Both guesses produced a name that
    matched no externconfig entry, which costs the dep its --extern - and
    that does not fail loudly. rustc falls back to searching -L and reports
    `multiple candidates` only when more than one version happens to be
    reachable, which in a small graph is never.

    So the crate name comes from the entry the declaration selects, the same
    way rust_repo's generated rules have named their deps since they had two
    versions of anything to tell apart.
    """
    quals = []
    for dep in deps:
        label = canonicalise(dep)
        label_parts = label.split(':')
        pkg_parts = label_parts[0].split('//')
        pkg = pkg_parts[-1]
        target_parts = label_parts[-1].split('#')
        target = target_parts[0]
        if target.startswith('_'):
            # plz's replace takes no count, and slicing is not supported
            # either; splitting is what is left. This matters for generated
            # targets, which is how a proto library is exposed.
            target_bits = target.split('_')
            target = '_'.join(target_bits[1:])
        qualifier = pkg + '/' + target if pkg else target
        quals += ['@' + qualifier]
    return quals


def _self_qualifier(name:str):
    """How dependents will name this rule: its package and rule name.

    A dependent derives the same string from the label it wrote, so the two
    agree without either having to know the other's version - which means
    normalising the name the same way it does. plz's internal `_name#tag`
    targets are how generated libraries are exposed, and a dependent writes
    the label with the tag while the rule is created without it.
    """
    pkg = package_name()
    target = name.split('#')[0]
    if target.startswith('_'):
        bits = target.split('_')
        target = '_'.join(bits[1:])
    return pkg + '/' + target if pkg else target


def _profile_flags(optimised:bool):
    """rustc codegen flags from the profile config knobs.

    Cargo's profile settings, mapped onto plz's build configs: the tuning
    knobs apply to the optimised configs, debug-assertions applies to both.
    """
    settings = []
    if optimised:
        if CONFIG.RUST.OPT_LEVEL:
            settings += ['opt-level=' + CONFIG.RUST.OPT_LEVEL]
        if CONFIG.RUST.LTO:
            settings += ['lto=' + CONFIG.RUST.LTO]
        if CONFIG.RUST.PANIC:
            settings += ['panic=' + CONFIG.RUST.PANIC]
        if CONFIG.RUST.STRIP:
            settings += ['strip=' + CONFIG.RUST.STRIP]
    if CONFIG.RUST.CODEGEN_UNITS:
        settings += ['codegen-units=' + CONFIG.RUST.CODEGEN_UNITS]
    if CONFIG.RUST.DEBUG_ASSERTIONS:
        settings += ['debug-assertions=' + CONFIG.RUST.DEBUG_ASSERTIONS]
    if not settings:
        return ''
    # rustc takes -C and its setting as two arguments
    args = []
    for s in settings:
        args += ['--rustc-flag=-C', '--rustc-flag=' + s]
    return ' '.join(args) + ' '


def _compile_cmds(crate_name:str, edition:str, crate_type:str, emit:str, features:list=None, test:bool=False, write_externconfig:bool=False, manifest:str=None, deps:list=None, lib_file:str='', static:bool=False, cc_deps:list=None, native_files:list=None, main_src:str='$SRCS_MAIN', pipeline_rmeta:bool=False, extra_flags:str='', qualifier:str=''):
    """Returns the {dbg, opt} command dict for compiling a crate via please_rust.

    Direct deps get --extern (by crate name, from --dep filtering); transitive
    crates in the sandbox stay reachable via -L only, mirroring cargo.
    """
    feature_args = ' '.join([f'--feature {f}' for f in features]) if features else ''
    test_arg = '--test ' if test else ''
    manifest_arg = '--manifest-path $SRCS_MANIFEST ' if manifest else ''
    dep_args = ' '.join([f'--dep {d}' for d in _dep_names(deps)]) + ' ' if deps else ''
    links = crate_type in ['bin', 'proc-macro', 'dylib', 'cdylib', 'staticlib'] or test
    cc_arg = '--cc $TOOLS_CC ' if links and CONFIG.RUST.CC_TOOL else ''
    static_arg = '--static ' if static else ''
    native_arg = '--native $SRCS_NATIVE ' if cc_deps else ''
    rmeta_arg = '--pipeline-rmeta ' if pipeline_rmeta else ''
    extra_args = extra_flags + ' ' if extra_flags else ''
    target_arg = target_flag(crate_type)
    base = f'{_AGGREGATE_EXTERNCONFIGS} && $TOOLS_PLEASE_RUST compile --externconfig externconfig {rmeta_arg}{target_arg}{extra_args}{manifest_arg}{dep_args}{cc_arg}{static_arg}{native_arg}--rustc $TOOLS_RUSTC --sysroot $TOOLS_SYSROOT --crate-name {crate_name} --edition {edition} --crate-type {crate_type} --emit {emit} {test_arg}{feature_args}'
    lib_file = lib_file or f'lib{crate_name}.rlib'
    # Qualified by the rule that produced it, so a dependent naming this
    # target gets this crate rather than another version of the same name.
    key = f'{crate_name}@{qualifier}' if qualifier else crate_name
    externconfig_lines = [f'{key}={lib_file}']
    for f in (native_files or []):
        externconfig_lines += [f'native={f}']
    echo_lines = '; '.join([f"echo '{line}' >> $OUTS_EXTERNCONFIG" for line in externconfig_lines])
    suffix = f" && {echo_lines}" if write_externconfig else ''
    dbg_profile = _profile_flags(optimised = False)
    opt_profile = _profile_flags(optimised = True)
    return {
        'dbg': f'{base} {dbg_profile}-g {main_src}{suffix}',
        'opt': f'{base} {opt_profile}-O {main_src}{suffix}',
        'cover': f'{base} {dbg_profile}--coverage -g {main_src}{suffix}',
    }


def _ide_fragment(name:str, crate_name:str, root:str, edition:str, features:list, deps:list, is_proc_macro:bool=False, manifest:str=None):
    """Per-crate metadata for `please_rust ide`.

    First-party rules exist only in plz's parser - nothing in please_rust ever
    sees a rust_library - so each rule writes down what it knows and the tool
    merges the fragments with the third-party graph it reads from the lock.

    Its own target, built only when a rust_project asks for it, so a normal
    build never runs one.
    """
    pkg = package_name()
    root_path = pkg + '/' + root if pkg else root
    dep_json = ', '.join(['{"name": "%s", "label": "%s"}' % (
        canonicalise(d).split(':')[-1].replace('-', '_'), canonicalise(d)) for d in deps])
    feature_json = ', '.join(['"%s"' % f for f in (features or [])])
    # The tool reads the manifest for CARGO_PKG_*, the same as a compile does.
    # A rule cannot read it here: parsing does not open files.
    manifest_json = '"%s/%s"' % (pkg, manifest) if manifest and pkg else (
        '"%s"' % manifest if manifest else 'null')
    body = '{"display_name": "%s", "root_module": "%s", "edition": "%s", "features": [%s], "manifest": %s, "is_proc_macro": %s, "deps": [%s]}' % (
        crate_name.replace('-', '_'), root_path, edition, feature_json, manifest_json, 'true' if is_proc_macro else 'false', dep_json)
    return build_rule(
        name = tag(name, 'ide'),
        outs = [name + '.ide.json'],
        # A heredoc rather than echo: the payload is JSON and quoting it
        # through a shell twice is how you get a file nothing can parse.
        cmd = "cat > $OUT <<'PLZ_IDE_EOF'\n" + body + "\nPLZ_IDE_EOF",
        labels = ['rust_ide'],
        visibility = ['PUBLIC'],
    )


def rust_project(name:str, lock:str='', targets:list=['//...'], exclude:list=[],
                 third_party_dir:str='plz-out/gen/third_party/crates',
                 sysroot:str='plz-out/bin/third_party/rust/rustc',
                 sysroot_src:str='plz-out/gen/third_party/rust/rust-src',
                 out:str='rust-project.json', visibility:list=None):
    """Writes a rust-project.json describing every Rust crate in the repo.

    Declare one of these in the repo root BUILD file and run it:

        plz run //:rust-project

    That finds every rust_library, rust_binary and rust_test in the repo, joins
    them to the third-party graph in the lock, and writes the file at the repo
    root - which is where rust-analyzer looks, and what the paths inside are
    relative to. There is no list of crates to keep up to date: a crate added
    anywhere is in the next run.

    It is a run target rather than a build rule because the crate list can only
    be discovered by querying the build graph, which a rule cannot do while it
    is being parsed. Nothing else here needs it, so nothing else pays for it.

    Args:
        name (str): Name of the rule.
        lock (str): The rust_resolve target whose lock describes third-party
                    crates. Without one only first-party crates are emitted.
        targets (list): Where to look for crates. The default covers the whole
                        repo, which is what a repo of one project wants. A
                        monorepo with Rust in one subtree can narrow it to
                        e.g. ['//services/...'] and skip parsing the rest.
        exclude (list): Label prefixes to leave out, e.g. ['//third_party/',
                        '//examples/']. Matched against the start of the
                        label, so '//test/' drops that whole subtree.
        third_party_dir (str): Where the generated crate subrepos land.
        sysroot (str): A rustup-shaped toolchain root - `bin/rustc` beside
                       `lib/rustlib`. That is the rustc component, and
                       deliberately not what `Sysroot` names: rust-analyzer
                       runs `<sysroot>/bin/rustc --print cfg`, and the
                       rust-std component has no bin/.
        sysroot_src (str): The standard library's sources, from
                           `<toolchain>_sysroot_src`. Without it there is no
                           go-to-definition into std.
        out (str): Where to write the file, relative to the repo root.
        visibility (list): Visibility declaration.
    """
    # The config value arrives subrepo-qualified (`///` and an empty name
    # when the plugin is its own repo); canonicalise gives the label back in
    # the form a command line takes.
    tool = canonicalise(CONFIG.RUST.PLEASE_RUST_TOOL)
    lock = canonicalise(lock) if lock else ''
    # Backticks rather than $(...): plz rewrites $(...) sequences in a cmd, and
    # this text has to survive into the script it writes untouched.
    filters = ''.join([" | grep -v '^%s'" % e for e in exclude])
    lock_setup = 'LOCK=`plz query outputs %s`' % lock if lock else 'LOCK='
    lock_arg = '--lock "$LOCK" ' if lock else ''
    build_labels = ' '.join([tool] + ([lock] if lock else []))
    script = '\n'.join([
        '#!/bin/sh',
        'set -eu',
        'cd "`plz query reporoot`"',
        'FRAGS=`plz query alltargets %s --include rust_ide --hidden%s || true`' % (' '.join(targets), filters),
        'if [ -z "$FRAGS" ]; then',
        '    echo "%s: no Rust crates found under %s" >&2' % (name, ' '.join(targets)),
        '    exit 1',
        'fi',
        # One build for the tool, the lock and every fragment. The fragments are
        # a line of JSON each, so this does not compile any Rust.
        'plz build %s $FRAGS >/dev/null' % build_labels,
        'TOOL=`plz query outputs %s`' % tool,
        lock_setup,
        'FILES=`plz query outputs $FRAGS`',
        '"$TOOL" ide %s--third-party-dir %s --sysroot %s --sysroot-src %s --first-party $FILES --output %s' % (
            lock_arg, third_party_dir, sysroot, sysroot_src, out),
        'echo "%s: wrote %s (`echo $FILES | wc -w` first-party crates)"' % (name, out),
    ])
    return build_rule(
        name = name,
        outs = [name + '.sh'],
        binary = True,
        cmd = "cat > $OUT <<'PLZ_PROJECT_EOF'\n" + script + "\nPLZ_PROJECT_EOF",
        labels = ['rust'],
        visibility = visibility,
    )


def rust_library(name:str, root:str, crate_name:str="", crate_type:str="rlib", modules:list=None, deps:list=[], cc_deps:list=[], edition:str="2018", features:list=None, build_root:str=None, build_deps:list|dict=None, target_dir:str=None, visibility:list=None):
    """Defines a build rule for a Rust library.

    Args:
        name (str): Name of the build rule. If crate_name is blank this is also the name of the crate.
        root (str): Source file that the `rustc` compiler starts from and makes up the root module
                  of the crate. Typically, `src/lib.rs`.
        crate_name (str): Name of the crate. If this is blank name will be used instead.
        modules (list): Local modules that make up the crate.
        deps (list): Dependencies of this crate (first-party rust_library or third-party rust_repo).
        cc_deps (list): C library targets (the cc plugin's cc_library) whose
                        static archives this crate's extern blocks link
                        against. The linkage is recorded in the rlib and the
                        archives flow to dependent binaries automatically.
        edition (str): Rust edition to compile with (2015, 2018, 2021, 2024).
        features (list): Feature cfgs to enable.
        visibility (list): Visibility declaration.
    """
    if build_root or build_deps:
        fail(f"rust_library {name}: build scripts are only supported for third-party crates via rust_repo")
    if not crate_name:
        crate_name = name.replace('-', '_')

    native_files = []
    for cc_dep in cc_deps:
        cc_name = canonicalise(cc_dep).split(':')[-1]
        native_files += [f'lib{cc_name}.a']

    # Output shape and linkability per crate type
    emit = 'dep-info,link'
    rustc_type = crate_type
    lib_file = ''
    linkable = False
    if crate_type == 'rlib':
        outs = {
            'rlib': [f'lib{crate_name}.rlib'],
            'rmeta': [f'lib{crate_name}.rmeta'],
            'externconfig': [f'{crate_name}.externconfig'],
        }
        emit = 'dep-info,link,metadata'
        rustc_type = 'lib'
        lib_file = f'lib{crate_name}.rlib'
        linkable = True
    elif crate_type in ['proc-macro', 'dylib']:
        # A proc macro is loaded by rustc itself, so it is named for the host;
        # a dylib is linked into the artifacts being produced, so it is named
        # for the target. Without --arch they are the same platform.
        ext = _dylib_ext(host = crate_type == 'proc-macro')
        outs = {
            'so': [f'lib{crate_name}{ext}'],
            'externconfig': [f'{crate_name}.externconfig'],
        }
        lib_file = f'lib{crate_name}{ext}'
        linkable = True
    elif crate_type == 'cdylib':
        ext = _dylib_ext()
        outs = [f'lib{crate_name}{ext}']
    elif crate_type == 'staticlib':
        outs = [f'lib{crate_name}.a']
    else:
        fail(f"rust_library {name}: unsupported crate_type {crate_type}")

    srcs = {
        'main': [root],
        'mods': modules or [],
    }
    if cc_deps:
        srcs['native'] = cc_deps

    # Pipelined compilation (the rules_rust two-action scheme): rlib crates
    # split into a `_X#link` compile whose deps are the metadata-only
    # `_X#rmeta` twins of its deps (rlib codegen never needs dep object
    # code), a `_X#rmeta` twin dependents' compiles hang off, and a public
    # filegroup that keeps dep publics so binary links still stage every
    # transitive rlib. Chains build at frontend depth; codegen parallelises.
    if CONFIG.RUST.PIPELINED_COMPILATION and crate_type == 'rlib':
        # Both compile rules require 'rust_rmeta': deps whose public rule
        # provides it (any pipelined rust library) are routed to their
        # metadata twin; anything else (cc_deps, proto wrappers) falls back
        # to the full build of itself.
        compile_rule = build_rule(
            name = tag(name, 'link'),
            srcs = srcs,
            outs = {
                'rlib': [f'lib{crate_name}.rlib'],
                'externconfig': [f'{crate_name}.externconfig'],
            },
            cmd = _compile_cmds(
                crate_name = crate_name,
                edition = edition,
                crate_type = rustc_type,
                emit = 'dep-info,link,metadata',
                features = features,
                write_externconfig = True,
                lib_file = lib_file,
                deps = deps,
                cc_deps = cc_deps,
                native_files = native_files,
                qualifier = _self_qualifier(name),
            ),
            deps = deps + cc_deps,
            requires = ['rust_rmeta'],
            tools = _rust_tools(link = False),
            needs_transitive_deps = True,
            labels = ['rust'],
        )
        rmeta_rule = build_rule(
            name = tag(name, 'rmeta'),
            srcs = srcs,
            outs = {
                'rmeta': [f'lib{crate_name}.rmeta'],
                'externconfig': [f'{crate_name}.rmeta.externconfig'],
            },
            cmd = _compile_cmds(
                crate_name = crate_name,
                edition = edition,
                crate_type = rustc_type,
                emit = 'dep-info,link,metadata',
                features = features,
                write_externconfig = True,
                lib_file = f'lib{crate_name}.rmeta',
                deps = deps,
                pipeline_rmeta = True,
                qualifier = _self_qualifier(name),
            ),
            deps = deps,
            requires = ['rust_rmeta'],
            tools = _rust_tools(link = False),
            needs_transitive_deps = True,
            labels = ['rust'],
        )
        _ide_fragment(name, crate_name, root, edition, features, deps, crate_type == 'proc-macro')
        return filegroup(
            name = name,
            srcs = [compile_rule],
            deps = deps + cc_deps,
            provides = {'rust_rmeta': rmeta_rule},
            visibility = visibility,
            labels = ['rust'],
        )

    provides = None
    if CONFIG.RUST.PIPELINED_COMPILATION and linkable:
        provides = {'rust_rmeta': ':' + tag(name, 'rmeta')}
    lib_rule = build_rule(
        name = name,
        srcs = srcs,
        outs = outs,
        provides = provides,
        cmd = _compile_cmds(
            crate_name = crate_name,
            edition = edition,
            crate_type = rustc_type,
            emit = emit,
            features = features,
            write_externconfig = linkable,
            lib_file = lib_file,
            deps = deps,
            cc_deps = cc_deps,
            native_files = native_files,
            qualifier = _self_qualifier(name),
        ),
        deps = deps + cc_deps,
        tools = _rust_tools(link = crate_type != 'rlib'),
        needs_transitive_deps = True,
        visibility = visibility,
        labels = ['rust'],
    )
    # Linkable non-rlib crates (proc-macros must run, dylibs must link) get a
    # copy-through `_X#rmeta` twin: it re-exports the externconfig under the
    # rust_rmeta shape while the full build stages via its dep, so dependents'
    # compiles wait for the complete artifact as they must.
    if CONFIG.RUST.PIPELINED_COMPILATION and linkable:
        build_rule(
            name = tag(name, 'rmeta'),
            srcs = [f':{name}|externconfig'],
            outs = {
                'externconfig': [f'{crate_name}.rmeta.externconfig'],
            },
            cmd = 'cp $SRCS $OUTS_EXTERNCONFIG',
            deps = [lib_rule],
            labels = ['rust'],
        )
    _ide_fragment(name, crate_name, root, edition, features, deps, crate_type == 'proc-macro')
    return lib_rule


def rust_binary(name:str, main:str, modules:list=None, deps:list=[], cc_deps:list=[], edition:str='2021', features:list=None, manifest:str=None, static:bool=None, build_root:str=None, build_deps:list|dict=None, build_compile_env:dict=None, build_run_env:dict=None, target_dir:str=None, visibility:list=None):
    """Defines a build rule for a Rust standalone binary.

    Args:
        name (str): Name of the binary.
        main (str): Source file containing the `main()` function that the `rustc` compiler starts
                  from. Typically, `src/main.rs`.
        modules (list): Local modules that make up the crate.
        deps (list): Dependencies of this crate (first-party rust_library or third-party rust_repo).
        edition (str): Rust edition to compile with (2015, 2018, 2021, 2024).
        features (list): Feature cfgs to enable.
        static (bool): Statically link the C runtime (-C target-feature=+crt-static),
                       producing a self-contained binary like Go's. Defaults to
                       the DefaultStatic plugin config.
        visibility (list): Visibility declaration.
    """
    if build_root or build_deps:
        fail(f"rust_binary {name}: build scripts are only supported for third-party crates via rust_repo")
    if static == None:
        # Apple does not ship a static libSystem and linking against it is
        # unsupported, so crt-static is a linux (and Windows) idea. Asking for
        # it explicitly still passes it through, and rustc will say no.
        static = CONFIG.RUST.DEFAULT_STATIC and CONFIG.TARGET_OS != 'darwin'
    crate_name = name.replace('-', '_')

    srcs = {
        'main': [main],
        'mods': modules or [],
    }
    if manifest:
        srcs['manifest'] = [manifest]
    if cc_deps:
        srcs['native'] = cc_deps

    bin_rule = build_rule(
        name = name,
        srcs = srcs,
        outs = [crate_name],
        binary = True,
        cmd = _compile_cmds(
            crate_name = crate_name,
            edition = edition,
            crate_type = 'bin',
            emit = 'dep-info,link',
            features = features,
            manifest = manifest,
            deps = deps,
            static = static,
            cc_deps = cc_deps,
        ),
        deps = deps + cc_deps,
        tools = _rust_tools(link = True),
        needs_transitive_deps = True,
        visibility = visibility,
        labels = ['rust'],
    )
    _ide_fragment(name, name, main, edition, features, deps, manifest = manifest)
    return bin_rule


def rust_test(name:str, root:str, modules:list=None, deps:list=[], cc_deps:list=[], edition:str="2018", features:list=None, manifest:str=None, visibility:list=None):
    """Defines a test rule for a Rust library.

    Note that the Rust test runner has no ability to output in a format plz
    understands (see https://github.com/rust-lang/rfcs/issues/816), so for now
    this is a straight pass/fail.

    Args:
        name (str): Name of the test.
        root (str): Source file that the `rustc` compiler starts from and makes up the test harness.
        modules (list): Local modules that make up the test harness.
        deps (list): Dependencies of the test harness.
        edition (str): Rust edition to compile with (2015, 2018, 2021, 2024).
        features (list): Feature cfgs to enable.
        visibility (list): Visibility declaration.
    """
    crate_name = name.replace('-', '_') + '_test'

    srcs = {}
    if manifest:
        srcs['manifest'] = [manifest]
    if cc_deps:
        srcs['native'] = cc_deps

    test_cmd = f'$TOOLS_PLEASE_RUST test --suite {name} -- $TEST'
    test_tools = {
        'please_rust': [CONFIG.RUST.PLEASE_RUST_TOOL],
    }
    # Only `plz cover` needs the llvm tools (llvm-profdata / llvm-cov), so
    # gate the dependency on the build config like go-rules does.
    if CONFIG.BUILD_CONFIG == 'cover':
        test_cmd = f'$TOOLS_PLEASE_RUST test --suite {name} --coverage --llvm-tools $TOOLS_LLVM/bin -- $TEST'
        test_tools['llvm'] = [CONFIG.RUST.LLVM_TOOLS]

    # plz excludes a test target's own srcs from coverage reports, but Rust
    # unit tests recompile the library sources (tests live inside them), so
    # they'd be dropped. Route the sources in through a non-test filegroup
    # dep instead of srcs; they stage at the same paths, and the compile
    # references the root by literal path. Not tag()-named: `_name#tag` deps
    # are internal to plz and skipped by the coverage walk.
    test_srcs = filegroup(
        name = '_%s_srcs' % name,
        srcs = [root] + (modules or []),
    )
    pkg = package_name()
    main_src = f'{pkg}/{root}' if pkg else root

    test_rule = build_rule(
        name = name,
        srcs = srcs,
        outs = [crate_name],
        binary = True,
        test = True,
        cmd = _compile_cmds(
            crate_name = crate_name,
            edition = edition,
            crate_type = 'bin',
            emit = 'dep-info,link',
            features = features,
            test = True,
            manifest = manifest,
            deps = deps,
            cc_deps = cc_deps,
            main_src = main_src,
        ),
        test_cmd = test_cmd,
        test_tools = test_tools,
        deps = deps + cc_deps + [test_srcs],
        tools = _rust_tools(link = True),
        needs_transitive_deps = True,
        visibility = visibility,
        labels = ['rust'],
    )
    _ide_fragment(name, crate_name, root, edition, features, deps, manifest = manifest)
    return test_rule


def rust_doc_test(name:str, root:str, crate_name:str="", modules:list=None, deps:list=[], edition:str="2018", features:list=None, visibility:list=None):
    """Runs a library's documentation tests via rustdoc --test.

    Args:
        name (str): Name of the test.
        root (str): The library's root source file (typically src/lib.rs).
        crate_name (str): Name of the crate under test (doctests refer to it
                          by this name). Defaults to the rule name.
        modules (list): Local modules that make up the crate.
        deps (list): The library under test plus its dependencies (doctests
                     compile as separate crates linking all of them).
        edition (str): Rust edition to compile with (2015, 2018, 2021, 2024).
        features (list): Feature cfgs to enable.
        visibility (list): Visibility declaration.
    """
    if not crate_name:
        crate_name = name.replace('-', '_')
    feature_args = ' '.join([f'--cfg \'feature="{f}"\'' for f in features]) if features else ''
    return gentest(
        name = name,
        data = {
            'main': [root],
            'mods': modules or [],
            'deps': deps,
        },
        no_test_output = False,
        test_cmd = ' && '.join([
            _AGGREGATE_EXTERNCONFIGS,
            f'$TOOLS_PLEASE_RUST test --suite {name} --externs-from-cwd -- $TOOLS_RUSTDOC --test $DATA_MAIN --crate-name {crate_name} --edition {edition} --sysroot $TOOLS_SYSROOT -L . {feature_args}',
        ]),
        test_tools = _rustdoc_tools(),
        visibility = visibility,
        labels = ['rust'],
    )


def rust_benchmark(name:str, root:str, modules:list=None, deps:list=[], edition:str="2018", features:list=None, visibility:list=None):
    """Defines a benchmark rule for a Rust library using Criterion.

    Criterion benchmarks provide their own main() via criterion_main!, so this
    compiles a plain binary (the cargo equivalent of `harness = false`).

    Args:
        name (str): Name of the benchmark binary.
        root (str): Source file that the `rustc` compiler starts from.
        modules (list): Local modules that make up the benchmark.
        deps (list): Dependencies of the benchmark.
        edition (str): Rust edition to compile with (2015, 2018, 2021, 2024).
        features (list): Feature cfgs to enable.
        visibility (list): Visibility declaration.
    """
    crate_name = name.replace('-', '_')

    deps = deps + [CONFIG.RUST.CRITERION_DEP]
    return build_rule(
        name = name,
        srcs = {
            'main': [root],
            'mods': modules or [],
        },
        outs = [crate_name],
        binary = True,
        cmd = _compile_cmds(
            crate_name = crate_name,
            edition = edition,
            crate_type = 'bin',
            emit = 'dep-info,link',
            features = features,
            deps = deps,
        ),
        deps = deps,
        tools = _rust_tools(link = True),
        needs_transitive_deps = True,
        visibility = visibility,
        labels = ['rust'],
    )


def rust_clippy(name:str, root:str, crate_name:str="", crate_type:str="lib", modules:list=None, deps:list=[], edition:str="2018", features:list=None, manifest:str=None, deny:list=["warnings"], visibility:list=None):
    """Lints a crate with clippy (clippy-driver is a rustc-compatible
    frontend, so this is the crate's compile run through it, metadata-only).

    Args:
        name (str): Name of the lint rule.
        root (str): The crate's root source file.
        crate_name (str): Name of the crate. Defaults to the rule name.
        crate_type (str): What the root is. A binary linted as a lib reports
                          every function reachable only from main as dead
                          code, so a rust_binary wants 'bin' here.
        modules (list): Local modules that make up the crate.
        deps (list): Dependencies of the crate.
        edition (str): Rust edition to compile with (2015, 2018, 2021, 2024).
        features (list): Feature cfgs to enable.
        manifest (str): The crate's Cargo.toml, for a crate that reads its own
                        package metadata. Without it CARGO_PKG_* is unset, and
                        anything deriving from it - clap's `#[command(version)]`
                        among them - fails to compile under the linter while
                        compiling fine everywhere else.
        deny (list): Lint groups promoted to errors (default: warnings, so
                     any clippy finding fails the build).
        visibility (list): Visibility declaration.
    """
    if not crate_name:
        crate_name = name.replace('-', '_')
    # extra-filename disambiguates from the library's own rmeta outputs
    deny_flags = ' '.join([f'--rustc-flag=-D{d}' for d in deny] + ['--rustc-flag=-Cextra-filename=-clippy'])
    srcs = {
        'main': [root],
        'mods': modules or [],
    }
    if manifest:
        srcs['manifest'] = [manifest]
    return build_rule(
        name = name,
        srcs = srcs,
        outs = [f'lib{crate_name}-clippy.rmeta'],
        cmd = _compile_cmds(
            crate_name = crate_name,
            edition = edition,
            crate_type = crate_type,
            emit = 'metadata',
            features = features,
            deps = deps,
            manifest = manifest,
            extra_flags = deny_flags,
        ),
        deps = deps,
        requires = ['rust_rmeta'],
        tools = {
            'please_rust': [CONFIG.RUST.PLEASE_RUST_TOOL],
            'rustc': [CONFIG.RUST.CLIPPY_TOOL],
            'sysroot': [CONFIG.RUST.SYSROOT],
        },
        needs_transitive_deps = True,
        visibility = visibility,
        labels = ['rust', 'lint'],
    )


def rust_fmt_test(name:str, srcs:list, edition:str="2018", visibility:list=None):
    """A test that fails when the given sources are not rustfmt-formatted.

    Args:
        name (str): Name of the test.
        srcs (list): Source files to check.
        edition (str): Rust edition to parse with (2015, 2018, 2021, 2024).
        visibility (list): Visibility declaration.
    """
    return gentest(
        name = name,
        data = srcs,
        no_test_output = True,
        test_cmd = f'$TOOLS_RUSTFMT --check --edition {edition} $DATA',
        test_tools = {
            'rustfmt': [CONFIG.RUST.RUSTFMT_TOOL],
        },
        visibility = visibility,
        labels = ['rust', 'fmt'],
    )


def rust_doc(name:str, root:str, crate_name:str="", modules:list=None, deps:list=[], edition:str="2018", features:list=None, visibility:list=None):
    """Generates rustdoc HTML documentation for a crate.

    Args:
        name (str): Name of the rule; also the output directory name.
        root (str): The crate's root source file.
        crate_name (str): Name of the crate. Defaults to the rule name.
        modules (list): Local modules that make up the crate.
        deps (list): Dependencies of the crate.
        edition (str): Rust edition to compile with (2015, 2018, 2021, 2024).
        features (list): Feature cfgs to enable.
        visibility (list): Visibility declaration.
    """
    if not crate_name:
        crate_name = name.replace('-', '_')
    feature_args = ' '.join([f'--cfg \'feature="{f}"\'' for f in features]) if features else ''
    return build_rule(
        name = name,
        srcs = {
            'main': [root],
            'mods': modules or [],
        },
        outs = [name],
        cmd = ' && '.join([
            _AGGREGATE_EXTERNCONFIGS,
            f'$TOOLS_PLEASE_RUST test --suite {name} --externs-from-cwd -- $TOOLS_RUSTDOC $SRCS_MAIN --crate-name {crate_name} --edition {edition} --out-dir $OUT --sysroot $TOOLS_SYSROOT -L . {feature_args}',
        ]),
        deps = deps,
        tools = _rustdoc_tools(),
        needs_transitive_deps = True,
        visibility = visibility,
        labels = ['rust'],
    )


def rust_bindgen(name:str, header:str, srcs:list=[], clang_args:list=[], bindgen_flags:list=[], visibility:list=None):
    """Generates Rust FFI bindings from a C header via bindgen.

    The output is a single .rs file, usable as a rust_library root or as a
    module. The bindgen binary itself is built from crates by rust_repo;
    libclang comes from the host (or the LibclangPath config), matching the
    host-cc convention.

    Args:
        name (str): Name of the rule; the output is <name>.rs.
        header (str): The C header to generate bindings for.
        srcs (list): Additional headers included by the main one.
        clang_args (list): Extra arguments passed to clang (after --).
        bindgen_flags (list): Extra flags passed to bindgen itself.
        visibility (list): Visibility declaration.
    """
    flags = ' '.join(bindgen_flags)
    cargs = ' '.join(clang_args)
    clang_sep = f' -- {cargs}' if cargs else ''
    env = {}
    if CONFIG.RUST.LIBCLANG_PATH:
        env['LIBCLANG_PATH'] = CONFIG.RUST.LIBCLANG_PATH
    return build_rule(
        name = name,
        srcs = {
            'header': [header],
            'extra': srcs,
        },
        outs = [name + '.rs'],
        cmd = f'$TOOLS_BINDGEN $SRCS_HEADER -o $OUT {flags}{clang_sep}',
        tools = {
            'bindgen': [CONFIG.RUST.BINDGEN_TOOL],
        },
        env = env,
        visibility = visibility,
        labels = ['rust', 'codegen'],
    )


def rust_crate_download(name:str, crate:str, version:str, hashes:list=None, labels:list=[], visibility:list=None):
    """Downloads a crate from crates.io.

    Args:
        name: Name of the rule.
        crate: Crate name on crates.io.
        version: Version to download.
        hashes: Optional hashes to verify the download.
        labels: Labels for the rule.
        visibility: Visibility specification.
    """
    url = f"https://static.crates.io/crates/{crate}/{crate}-{version}.crate"

    return remote_file(
        name = name,
        url = url,
        hashes = hashes,
        extract = True,
        labels = labels,
        visibility = visibility,
    )


def rust_git_download(name:str, crate:str, version:str, repo:str, revision:str, hashes:list=None,
                      host:str="github.com", subdir:str="", visibility:list=None):
    """Downloads a crate's source from a git forge archive (for forks and
    unpublished revisions), normalized to the {crate}-{version} layout that
    rust_repo expects. The go-rules `download` pattern: the crate keeps its
    canonical name and version, the bytes come from the fork.

    Args:
        name: Name of the rule.
        crate: Crate name (canonical, as dependents refer to it).
        version: Version dependents resolve against.
        repo: owner/repo on the forge.
        revision: Commit sha or tag to fetch.
        hashes: Optional archive hashes to verify.
        host: Forge host serving /archive/ tarballs (github.com, gitlab works too).
        subdir: Path of the crate within the repo, for workspace members.
    """
    dl = remote_file(
        name = tag(name, "git"),
        url = f"https://{host}/{repo}/archive/{revision}.tar.gz",
        hashes = hashes,
        extract = True,
    )
    src_path = f"$SRCS/{subdir}" if subdir else "$SRCS"
    return build_rule(
        name = name,
        srcs = [dl],
        outs = [f"{crate}-{version}"],
        cmd = f"mv {src_path} $OUT",
        visibility = visibility,
    )


def build_triple():
    """The triple this repo is being built for, derived the way rust_toolchain
    derives its download URL. Resolution is per-platform because Rust's
    cfg-gated dependencies differ by platform, so a mac developer must resolve
    the darwin graph rather than a checked-in linux one, and a cross-compile
    must resolve the graph of the platform it is producing rather than the one
    it is running on. Without --arch these are the same machine."""
    return target_triple('rust_resolve')


def _subrepo_ref(value:str):
    """A config value as seen from inside a generated subrepo.

    A label that already names a subrepo (`///rust//tools:x`) is absolute and
    means the same thing everywhere, so it passes through untouched. This is
    what a consumer sees for any config value it has not overridden, because
    Please qualifies a plugin's own DefaultValue into the plugin's subrepo.
    Prefixing those with @ used to rewrite them into the consuming repo,
    where the target does not exist, which is why consumers had to override
    the tool with a label of their own.

    A plain host-repo label (`//third_party/rust:toolchain_rustc`) does need
    the @ prefix to keep pointing at the host from inside a subrepo. File
    paths (from config overrides) pass through.
    """
    # Please qualifies a plugin's DefaultValue into the plugin's subrepo. In
    # the plugin's own repo that subrepo name is empty, so the value comes
    # back as ///// + path; collapse it to the plain host label it means.
    if value.startswith("////"):
        value = value[3:]
    if value.startswith("///"):
        return value
    if value.startswith("//") or value.startswith(":"):
        return f"@{value}"
    return value


def rust_repo(
    name: str = None,
    crate: str = "",
    version: str = "",
    features: list = [],
    install: list = [],
    deps: list = [],
    hashes: list = None,
    patch: list = None,
    visibility: list = ["PUBLIC"],
    third_party_path: str = "",
    labels: list = [],
    dep_overrides: dict = {},
    lock: str = "auto",
    indirect: bool = False,
    default_features: bool = True,
    bin: bool = False,
    download: str = None,
    git_repo: str = "",
    git_revision: str = "",
    platforms: list = None,
):
    """Downloads a crate and generates BUILD files as a subrepo.

    This rule downloads a crate from crates.io, invokes please_rust generate to
    create BUILD files, and registers the result as a subrepo. This is the Rust
    equivalent of go_repo from go-rules.

    Args:
        name: Rule name. If provided, creates an install alias. If omitted, the
              crate is an indirect dependency (transitive dep).
        crate: Crate name on crates.io.
        version: Exact version to fetch.
        features: Features to enable for this crate.
        install: Targets to export (defaults to [crate]). Only used if name is set.
        deps: Additional dependencies not in Cargo.toml.
        hashes: Optional hashes to verify the download.
        patch: Patch files to apply.
        visibility: Visibility for the install target.
        third_party_path: Where subrepos are placed. Defaults to the package
                          these declarations live in, which is what keeps
                          subrepo names distinct between repos.
        labels: Labels for the rule.
        dep_overrides: Routes named deps to versioned subrepos, e.g.
                       {"hashbrown": "hashbrown_0_12_3"}. Keys are real crate
                       (package) names, values are subrepo names. Interim
                       mechanism; superseded by the resolved lock file.
        lock: Label of the resolved lock (the rust_resolve rule); defaults to
              the rust_resolve rule in this package. When it
              contains an entry for this subrepo, features and dependency
              routing come from it. Pass an empty string to use heuristic
              resolution (e.g. for a standalone crate outside the lock).
        indirect: True for machine-added transitive dependencies (maintained
                  by `please_rust sync`); their features are derived, never
                  user requests, and sync may prune them when unused.
        default_features: Cargo semantics for direct deps: default features
                          are enabled unless this is False.
        bin: True to alias the crate's binary target (<crate>_bin) instead of
             its library, for crates used as tools (e.g. protoc plugins).
        download: A rule providing the crate source (a {crate}-{version} dir
                  with Cargo.toml at its root) instead of the crates.io
                  tarball — e.g. a rust_git_download of a fork.
        git_repo: owner/repo shorthand: fetch the source from this git forge
                  repository instead of crates.io.
        git_revision: Commit sha or tag for git_repo.
        platforms: The operating systems (in Rust's `target_os` vocabulary)
                   whose resolution reaches this crate. Omitted for the
                   overwhelming majority of crates, which build anywhere;
                   `please_rust sync` writes it only when a crate is gated,
                   and what it writes is a property of the crate rather than
                   of the machine that ran sync, so everyone's checkout agrees.
                   On a platform not listed the target is labelled `manual`,
                   which keeps `plz build //...` from compiling a crate that
                   cannot compile here - objc2 says so in a compile_error! -
                   while an explicit build of it still works.
    """
    if platforms != None:
        # Rust's target_os on the left, plz's CONFIG.OS on the right.
        plz_os = {'macos': 'darwin', 'linux': 'linux', 'windows': 'windows'}
        here = [p for p in platforms if plz_os.get(p, p) == CONFIG.OS]
        if not here:
            labels = labels + ['manual']

    if not crate:
        fail("crate is required for rust_repo")

    # Subrepo names are package path + name and are registered globally by
    # plz, with no qualification by the declaring repo. Deriving the paths
    # from the package these declarations live in therefore keeps a plugin's
    # own crates from colliding with a consumer's: put them in a package the
    # consumer does not use and the names differ.
    pkg_name = package_name()
    if not third_party_path:
        third_party_path = pkg_name
    if lock == "auto":
        lock = f"//{pkg_name}:rust_lock" if pkg_name else "//:rust_lock"
    if not version:
        fail("version is required for rust_repo")

    # Normalize crate name for subrepo (replace - with _)
    crate_normalized = crate.replace("-", "_")

    # If no name provided, this is an indirect dep - just use crate_normalized
    if not name:
        name = crate_normalized
        subrepo_name = crate_normalized
    else:
        # The provided name is the subrepo name, verbatim. Versioned
        # duplicates use the `crate-x.y.z` convention (written by sync).
        subrepo_name = name

    # Download the crate (crates.io tarball, a git forge archive, or any
    # user-provided rule via download=)
    if git_repo:
        download = rust_git_download(
            name = tag(name, "download"),
            crate = crate,
            version = version,
            repo = git_repo,
            revision = git_revision or version,
            hashes = hashes,
        )
    elif not download:
        download = rust_crate_download(
            name = tag(name, "download"),
            crate = crate,
            version = version,
            hashes = hashes,
        )

    # The crate's manifest, staged for the package-level rust_resolve rule
    build_rule(
        name = tag(name, "manifest"),
        srcs = [download],
        cmd = "cp $SRCS/Cargo.toml $OUT",
        outs = [f"{subrepo_name}.manifest.toml"],
    )

    # Build feature args
    features_arg = ",".join(features) if features else ""

    # Build install args - use the actual crate name (normalized), not subrepo_name
    install_targets = install if install else [crate_normalized]
    install_arg = ",".join(install_targets)

    # At the repo root package_name() is empty; labels must not double-slash
    subrepo_path = f"{pkg_name}/{subrepo_name}" if pkg_name else subrepo_name
    pkg_root = f"{crate}-{version}"

    # Generate BUILD files
    # Note: remote_file with extract=True extracts contents into a directory named after the crate
    lock_flag = "--lock $SRCS_LOCK " if lock else ""
    target_triple = build_triple()
    # Cross-compiling: libraries are built for the target, while build scripts,
    # proc macros and installed binaries run during the build and stay on the
    # host. Without --arch there is nothing to say.
    cross_flag = ""
    if CONFIG.TARGET_OS != CONFIG.HOSTOS or CONFIG.TARGET_ARCH != CONFIG.HOSTARCH:
        cross_flag = f"--compile-target {target_triple} "
    pipeline_flag = "--pipeline " if CONFIG.RUST.PIPELINED_COMPILATION else ""
    # Only baked in when somebody picked a number. Left alone the generated
    # rules say nothing about NUM_JOBS and please_rust reads the machine, so
    # the same BUILD file is generated on a laptop and a build farm.
    jobs_flag = f"--build-script-jobs {CONFIG.RUST.BUILD_SCRIPT_JOBS} " if CONFIG.RUST.BUILD_SCRIPT_JOBS else ""
    cc_is_label = CONFIG.RUST.CC_TOOL and (CONFIG.RUST.CC_TOOL.startswith("//") or CONFIG.RUST.CC_TOOL.startswith(":"))
    cc_ref = _subrepo_ref(CONFIG.RUST.CC_TOOL) if CONFIG.RUST.CC_TOOL else ""
    cc_flag = f"--cc-label '{cc_ref}' " if cc_is_label else ""
    tool_ref = _subrepo_ref(CONFIG.RUST.PLEASE_RUST_TOOL)
    rustc_ref = _subrepo_ref(CONFIG.RUST.RUSTC)
    sysroot_ref = _subrepo_ref(CONFIG.RUST.SYSROOT)
    cmds = [
        # Remove any existing BUILD files or plzconfig
        "rm -rf $SRCS_CRATE/.plzconfig",
        # -type f so a crate shipping a build/ directory survives this on a
        # case-insensitive filesystem, where find matches it by either name
        "find $SRCS_CRATE -type f \\( -name BUILD -o -name BUILD.plz \\) -delete",
        # Run please_rust generate (SRCS_CRATE points directly to the extracted directory)
        f"$TOOL generate --crate-name {crate} --version {version} --src-root $SRCS_CRATE --subrepo {subrepo_path} --features '{features_arg}' --install '{install_arg}' --third-party-folder '{third_party_path}' --target {target_triple} --tool-label '{tool_ref}' --rustc-label '{rustc_ref}' --sysroot-label '{sysroot_ref}' {cc_flag}{cross_flag}{lock_flag}{pipeline_flag}{jobs_flag}" + " ".join([f"--override {k}={v}" for k, v in sorted(dep_overrides.items())]),
        # Move to output
        "mv $SRCS_CRATE $OUT",
    ]
    cmd = " && ".join(cmds)

    srcs = {
        "crate": [download],
    }
    if lock:
        srcs["lock"] = [lock]

    # Always use a tagged name for the build_rule since we need to create an alias
    repo = build_rule(
        name = tag(name, "repo"),
        srcs = srcs,
        cmd = cmd,
        outs = [subrepo_name],
        tools = [CONFIG.RUST.PLEASE_RUST_TOOL],
        deps = deps,
        output_is_complete = True,
        # Downloading a tarball and writing BUILD files gains nothing from a
        # remote worker, and running them there means Please reads the
        # subrepo's config through its remote filesystem. That path segfaults
        # when the subrepo's tree is absent from the remote cache
        # (remotefs.New dereferences a nil tree), so keep these local unless
        # a consumer asks otherwise.
        local = CONFIG.RUST.LOCAL_SUBREPOS,
        labels = labels + [f"rust_crate:{crate}@{version}"],
    )

    # Register as subrepo
    # Since we moved $SRCS to $OUT directly, the package_root is empty
    subrepo(
        name = subrepo_name,
        dep = repo,
    )

    # Always create an alias that wraps the subrepo target
    # This allows `:name` to resolve to the rlib, not the directory
    # The target inside the subrepo is named after the crate (crate_normalized),
    # while the subrepo itself may have a different name (subrepo_name) for versioned crates
    if bin:
        # Alias the runnable binary target from the subrepo
        return filegroup(
            name = name,
            binary = True,
            exported_deps = [f"///{subrepo_path}//:{crate_normalized}_bin"],
            visibility = visibility,
            labels = labels,
        )
    # Under pipelined compilation, first-party rust_library compiles hang off
    # deps' metadata twins; alias the subrepo twin under the same `_name#rmeta`
    # convention so the label transform works for third-party deps too.
    if CONFIG.RUST.PIPELINED_COMPILATION:
        rmeta_alias = filegroup(
            name = "_%s#rmeta" % name,
            visibility = visibility,
            exported_deps = [f"///{subrepo_path}//:_{crate_normalized}#rmeta"],
        )
        return filegroup(
            name = name,
            visibility = visibility,
            exported_deps = [f"///{subrepo_path}//:{crate_normalized}"],
            provides = {"rust_rmeta": rmeta_alias},
            labels = labels,
        )
    return filegroup(
        name = name,
        visibility = visibility,
        exported_deps = [f"///{subrepo_path}//:{crate_normalized}"],
        labels = labels,
    )


def rust_resolve(name:str, entries:list, target:str="", visibility:list=["PUBLIC"]):
    """Resolves versions and features across the declared crate graph.

    Maintained by `please_rust sync`. Each entry is
    "subrepo|crate|version|features|root|default_features"; the rule consumes
    every crate's Cargo.toml (staged by rust_repo) and produces the resolved
    lock consumed by each subrepo's BUILD generation. Resolution is fully
    deterministic and runs inside the build graph - there is no committed
    lock file and no network access.

    Args:
        name: Name of the rule (rust_repo's lock arg points at it).
        entries: Declared crate graph, one string per rust_repo entry.
        target: Target triple to resolve for. Defaults to the host's, so a
                repo shared between linux and mac developers resolves the
                graph each of them actually builds; pass one explicitly to
                pin a single platform.
        visibility: Visibility specification.
    """
    if not target:
        target = build_triple()
    pkg = package_name()
    entry_flags = " ".join([f"--entry '{e}'" for e in entries])
    manifest_srcs = []
    for e in entries:
        subrepo = e.split('|')[0]
        manifest_srcs += [f":_{subrepo}#manifest"]
    return build_rule(
        name = name,
        srcs = manifest_srcs,
        outs = ["rust.lock"],
        cmd = f"$TOOL resolve {entry_flags} --manifest-dir {pkg} --target {target} --output $OUT",
        tools = [CONFIG.RUST.PLEASE_RUST_TOOL],
        visibility = visibility,
    )
