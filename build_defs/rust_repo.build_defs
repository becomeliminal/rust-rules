"""Build rules for downloading Rust crates and generating BUILD files as subrepos.

This implements the subrepo architecture for Rust, similar to go_repo in go-rules.
"""

def rust_crate_download(name:str, crate:str, version:str, hashes:list=None, labels:list=[], visibility:list=None):
    """Downloads a crate from crates.io.

    Args:
        name: Name of the rule.
        crate: Crate name on crates.io.
        version: Version to download.
        hashes: Optional hashes to verify the download.
        labels: Labels for the rule.
        visibility: Visibility specification.
    """
    url = f"https://static.crates.io/crates/{crate}/{crate}-{version}.crate"

    return remote_file(
        name = name,
        url = url,
        hashes = hashes,
        extract = True,
        labels = labels,
        visibility = visibility,
    )


def rust_git_download(name:str, crate:str, version:str, repo:str, revision:str, hashes:list=None,
                      host:str="github.com", subdir:str="", visibility:list=None):
    """Downloads a crate's source from a git forge archive (for forks and
    unpublished revisions), normalized to the {crate}-{version} layout that
    rust_repo expects. The go-rules `download` pattern: the crate keeps its
    canonical name and version, the bytes come from the fork.

    Args:
        name: Name of the rule.
        crate: Crate name (canonical, as dependents refer to it).
        version: Version dependents resolve against.
        repo: owner/repo on the forge.
        revision: Commit sha or tag to fetch.
        hashes: Optional archive hashes to verify.
        host: Forge host serving /archive/ tarballs (github.com, gitlab works too).
        subdir: Path of the crate within the repo, for workspace members.
    """
    dl = remote_file(
        name = tag(name, "git"),
        url = f"https://{host}/{repo}/archive/{revision}.tar.gz",
        hashes = hashes,
        extract = True,
    )
    src_path = f"$SRCS/{subdir}" if subdir else "$SRCS"
    return build_rule(
        name = name,
        srcs = [dl],
        outs = [f"{crate}-{version}"],
        cmd = f"mv {src_path} $OUT",
        visibility = visibility,
    )


def _subrepo_ref(value:str):
    """A config value as seen from inside a generated subrepo: host-repo
    labels need the @ prefix; file paths (config overrides) pass through."""
    if value.startswith("//") or value.startswith(":"):
        return f"@{value}"
    return value


def rust_repo(
    name: str = None,
    crate: str = "",
    version: str = "",
    features: list = [],
    install: list = [],
    deps: list = [],
    hashes: list = None,
    patch: list = None,
    visibility: list = ["PUBLIC"],
    third_party_path: str = "third_party/rust",
    labels: list = [],
    dep_overrides: dict = {},
    lock: str = "//third_party/rust:rust_lock",
    indirect: bool = False,
    default_features: bool = True,
    bin: bool = False,
    download: str = None,
    git_repo: str = "",
    git_revision: str = "",
):
    """Downloads a crate and generates BUILD files as a subrepo.

    This rule downloads a crate from crates.io, invokes please_rust generate to
    create BUILD files, and registers the result as a subrepo. This is the Rust
    equivalent of go_repo from go-rules.

    Args:
        name: Rule name. If provided, creates an install alias. If omitted, the
              crate is an indirect dependency (transitive dep).
        crate: Crate name on crates.io.
        version: Exact version to fetch.
        features: Features to enable for this crate.
        install: Targets to export (defaults to [crate]). Only used if name is set.
        deps: Additional dependencies not in Cargo.toml.
        hashes: Optional hashes to verify the download.
        patch: Patch files to apply.
        visibility: Visibility for the install target.
        third_party_path: Where subrepos are placed.
        labels: Labels for the rule.
        dep_overrides: Routes named deps to versioned subrepos, e.g.
                       {"hashbrown": "hashbrown_0_12_3"}. Keys are real crate
                       (package) names, values are subrepo names. Interim
                       mechanism; superseded by the resolved lock file.
        lock: Label of the resolved lock (the rust_resolve rule). When it
              contains an entry for this subrepo, features and dependency
              routing come from it. Pass an empty string to use heuristic
              resolution (e.g. for a standalone crate outside the lock).
        indirect: True for machine-added transitive dependencies (maintained
                  by `please_rust sync`); their features are derived, never
                  user requests, and sync may prune them when unused.
        default_features: Cargo semantics for direct deps: default features
                          are enabled unless this is False.
        bin: True to alias the crate's binary target (<crate>_bin) instead of
             its library, for crates used as tools (e.g. protoc plugins).
        download: A rule providing the crate source (a {crate}-{version} dir
                  with Cargo.toml at its root) instead of the crates.io
                  tarball — e.g. a rust_git_download of a fork.
        git_repo: owner/repo shorthand: fetch the source from this git forge
                  repository instead of crates.io.
        git_revision: Commit sha or tag for git_repo.
    """
    if not crate:
        fail("crate is required for rust_repo")
    if not version:
        fail("version is required for rust_repo")

    # Normalize crate name for subrepo (replace - with _)
    crate_normalized = crate.replace("-", "_")

    # If no name provided, this is an indirect dep - just use crate_normalized
    if not name:
        name = crate_normalized
        subrepo_name = crate_normalized
    else:
        # The provided name is the subrepo name, verbatim. Versioned
        # duplicates use the `crate-x.y.z` convention (written by sync).
        subrepo_name = name

    # Download the crate (crates.io tarball, a git forge archive, or any
    # user-provided rule via download=)
    if git_repo:
        download = rust_git_download(
            name = tag(name, "download"),
            crate = crate,
            version = version,
            repo = git_repo,
            revision = git_revision or version,
            hashes = hashes,
        )
    elif not download:
        download = rust_crate_download(
            name = tag(name, "download"),
            crate = crate,
            version = version,
            hashes = hashes,
        )

    # The crate's manifest, staged for the package-level rust_resolve rule
    build_rule(
        name = tag(name, "manifest"),
        srcs = [download],
        cmd = "cp $SRCS/Cargo.toml $OUT",
        outs = [f"{subrepo_name}.manifest.toml"],
    )

    # Build feature args
    features_arg = ",".join(features) if features else ""

    # Build install args - use the actual crate name (normalized), not subrepo_name
    install_targets = install if install else [crate_normalized]
    install_arg = ",".join(install_targets)

    pkg_name = package_name()
    # At the repo root package_name() is empty; labels must not double-slash
    subrepo_path = f"{pkg_name}/{subrepo_name}" if pkg_name else subrepo_name
    pkg_root = f"{crate}-{version}"

    # Generate BUILD files
    # Note: remote_file with extract=True extracts contents into a directory named after the crate
    lock_flag = "--lock $SRCS_LOCK " if lock else ""
    cc_is_label = CONFIG.RUST.CC_TOOL and (CONFIG.RUST.CC_TOOL.startswith("//") or CONFIG.RUST.CC_TOOL.startswith(":"))
    cc_ref = _subrepo_ref(CONFIG.RUST.CC_TOOL) if CONFIG.RUST.CC_TOOL else ""
    cc_flag = f"--cc-label {cc_ref} " if cc_is_label else ""
    tool_ref = _subrepo_ref(CONFIG.RUST.PLEASE_RUST_TOOL)
    rustc_ref = _subrepo_ref(CONFIG.RUST.RUSTC)
    sysroot_ref = _subrepo_ref(CONFIG.RUST.SYSROOT)
    cmds = [
        # Remove any existing BUILD files or plzconfig
        "rm -rf $SRCS_CRATE/.plzconfig",
        "find $SRCS_CRATE -name BUILD -delete",
        # Run please_rust generate (SRCS_CRATE points directly to the extracted directory)
        f"$TOOL generate --crate-name {crate} --version {version} --src-root $SRCS_CRATE --subrepo {subrepo_path} --features '{features_arg}' --install '{install_arg}' --third-party-folder {third_party_path} --tool-label {tool_ref} --rustc-label {rustc_ref} --sysroot-label {sysroot_ref} {cc_flag}{lock_flag}" + " ".join([f"--override {k}={v}" for k, v in sorted(dep_overrides.items())]),
        # Move to output
        "mv $SRCS_CRATE $OUT",
    ]
    cmd = " && ".join(cmds)

    srcs = {
        "crate": [download],
    }
    if lock:
        srcs["lock"] = [lock]

    # Always use a tagged name for the build_rule since we need to create an alias
    repo = build_rule(
        name = tag(name, "repo"),
        srcs = srcs,
        cmd = cmd,
        outs = [subrepo_name],
        tools = [CONFIG.RUST.PLEASE_RUST_TOOL],
        deps = deps,
        output_is_complete = True,
        labels = labels + [f"rust_crate:{crate}@{version}"],
    )

    # Register as subrepo
    # Since we moved $SRCS to $OUT directly, the package_root is empty
    subrepo(
        name = subrepo_name,
        dep = repo,
    )

    # Always create an alias that wraps the subrepo target
    # This allows `:name` to resolve to the rlib, not the directory
    # The target inside the subrepo is named after the crate (crate_normalized),
    # while the subrepo itself may have a different name (subrepo_name) for versioned crates
    if bin:
        # Alias the runnable binary target from the subrepo
        return filegroup(
            name = name,
            binary = True,
            exported_deps = [f"///{subrepo_path}//:{crate_normalized}_bin"],
            visibility = visibility,
            labels = labels,
        )
    return filegroup(
        name = name,
        visibility = visibility,
        exported_deps = [f"///{subrepo_path}//:{crate_normalized}"],
        labels = labels,
    )


def rust_resolve(name:str, entries:list, target:str="x86_64-unknown-linux-gnu", visibility:list=["PUBLIC"]):
    """Resolves versions and features across the declared crate graph.

    Maintained by `please_rust sync`. Each entry is
    "subrepo|crate|version|features|root|default_features"; the rule consumes
    every crate's Cargo.toml (staged by rust_repo) and produces the resolved
    lock consumed by each subrepo's BUILD generation. Resolution is fully
    deterministic and runs inside the build graph - there is no committed
    lock file and no network access.

    Args:
        name: Name of the rule (rust_repo's lock arg points at it).
        entries: Declared crate graph, one string per rust_repo entry.
        target: Target triple to resolve for.
        visibility: Visibility specification.
    """
    pkg = package_name()
    entry_flags = " ".join([f"--entry '{e}'" for e in entries])
    manifest_srcs = []
    for e in entries:
        subrepo = e.split('|')[0]
        manifest_srcs += [f":_{subrepo}#manifest"]
    return build_rule(
        name = name,
        srcs = manifest_srcs,
        outs = ["rust.lock"],
        cmd = f"$TOOL resolve {entry_flags} --manifest-dir {pkg} --target {target} --output $OUT",
        tools = [CONFIG.RUST.PLEASE_RUST_TOOL],
        visibility = visibility,
    )
