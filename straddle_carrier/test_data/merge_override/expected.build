# Expected output for override test
# - serde: completely replaced with new version/features
# - old_only_crate: kept (not in new)
# - new_only_crate: added

rust_crate(
    name = "new_only_crate",
    crate = "new-only",
    version = "0.5.0",
    edition = "2021",
)

rust_crate(
    name = "old_only_crate",
    crate = "old-only",
    version = "0.1.0",
    edition = "2021",
)

rust_crate(
    name = "serde",
    crate = "serde",
    version = "1.0.200",
    edition = "2021",
    features = [
        "derive",
    ],
)

