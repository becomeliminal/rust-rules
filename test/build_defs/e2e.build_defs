subinclude("///e2e//build_defs:e2e")

_please_repo_e2e_test = please_repo_e2e_test

def please_repo_e2e_test(name, expected_output=None, plz_command, repo, labels=[]):
    """Runs plz inside a nested consumer repo against the exported plugin,
    with the outer repo's toolchain and tool injected by config override."""
    return _please_repo_e2e_test(
        name = name,
        expected_output = expected_output,
        plz_command = plz_command.replace(
            "plz ",
            "plz -o please.PluginRepo:file://$TMP_DIR/$DATA_PLUGIN_REPO " +
            "-o plugin.rust.rustc:$TOOLS_RUSTC " +
            "-o plugin.rust.sysroot:$TOOLS_SYSROOT " +
            "-o plugin.rust.pleaserusttool:$TOOLS_PLEASE_RUST ",
        ),
        repo = repo,
        data = {
            "PLUGIN_REPO": ["//test:export"],
        },
        tools = {
            "RUSTC": ["//third_party/rust:toolchain|rustc"],
            "SYSROOT": ["//third_party/rust:toolchain_sysroot"],
            "PLEASE_RUST": ["//tools/please_rust:bootstrap"],
        },
        labels = labels,
    )
