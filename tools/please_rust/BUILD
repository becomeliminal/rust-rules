subinclude("//build_defs:rust")

# The tool consumers get by default: a released binary, hash-pinned per
# platform, the way go-rules ships please_go. Nothing to build, no toolchain
# to download, no cargo, and it works under remote execution — the bootstrap
# below cannot claim any of those, and exists only to break the egg when
# developing these rules.
#
# Update on release: publish the tag, then pin the hashes it produced.
PLEASE_RUST_VERSION = "v0.7.0"

PLEASE_RUST_HASHES = {
    "linux_amd64": "432a776d0f5cadf1ba597f5706fbaf6451deef236bcad054dee778b78fcc2a9b",
    "darwin_arm64": "e4d5bbb911b5d5e80feee3f00253f0c3550d3b5383e0533373aec53d9070d230",
    # darwin_amd64 is not published: its runners are being retired, so Intel
    # Macs build the tool from source
}

_HOST_PLAT = f"{CONFIG.HOSTOS}_{CONFIG.HOSTARCH}"

for _plat, _hash in PLEASE_RUST_HASHES.items():
    _native = _HOST_PLAT == _plat
    remote_file(
        name = "please_rust_release" if _native else f"please_rust_release_{_plat}",
        binary = True,
        hashes = [_hash],
        url = f"https://github.com/becomeliminal/rust-rules/releases/download/{PLEASE_RUST_VERSION}/please_rust-{_plat}",
        visibility = ["PUBLIC"] if _native else None,
    )

# A platform with no published binary yet builds the tool from source rather
# than failing to find a target that was never declared for it. That is a
# cargo build, with everything the comment above says it costs, but it is the
# difference between a slow first build and an unusable plugin — and it stops
# applying to a platform the moment its hash is pinned above.
if _HOST_PLAT not in PLEASE_RUST_HASHES:
    filegroup(
        name = "please_rust_release",
        srcs = [":bootstrap"],
        binary = True,
        visibility = ["PUBLIC"],
    )

_MODULES = [
    "src/build_script.rs",
    "src/compile.rs",
    "src/generate.rs",
    "src/pubgrub_solver.rs",
    "src/resolve.rs",
    "src/sync.rs",
    "src/workspace.rs",
    "src/ide.rs",
    "src/test.rs",
]

_DEPS = [
    "//third_party/crates:anyhow",
    "//third_party/crates:cargo_toml",
    "//third_party/crates:cfg_expr",
    "//third_party/crates:clap",
    "//third_party/crates:proc_macro2",
    "//third_party/crates:pubgrub",
    "//third_party/crates:semver",
    "//third_party/crates:serde",
    "//third_party/crates:serde_json",
    "//third_party/crates:syn",
    "//third_party/crates:thiserror",
    "//third_party/crates:toml",
    "//third_party/crates:walkdir",
]

# please_rust built hermetically by this plugin's own rules against the
# rust_repo crate graph in //third_party/rust. This is the real tool; the
# cargo bootstrap below exists only to break the egg (rust_repo subrepos are
# generated by the bootstrap, which the crates here are built from).
rust_binary(
    name = "please_rust",
    main = "src/main.rs",
    modules = _MODULES,
    edition = "2021",
    manifest = "Cargo.toml",
    visibility = ["PUBLIC"],
    deps = _DEPS,
)

rust_test(
    name = "please_rust_test",
    root = "src/main.rs",
    modules = _MODULES,
    edition = "2021",
    manifest = "Cargo.toml",
    deps = _DEPS,
)

# The tool's own source was never linted or format-checked - both rules
# existed but were applied only to examples/package, so the 7k lines
# everything else depends on went unchecked.
rust_clippy(
    name = "lint",
    root = "src/main.rs",
    crate_name = "please_rust",
    crate_type = "bin",
    modules = _MODULES,
    edition = "2021",
    manifest = "Cargo.toml",
    deps = _DEPS,
)

rust_fmt_test(
    name = "fmt_test",
    srcs = ["src/main.rs"] + _MODULES,
    edition = "2021",
)

# Bootstrap target that builds please_rust using cargo directly.
# This is similar to how go-rules bootstraps please_go.
# Once built, this can be used as the tool for rust_repo.
genrule(
    name = "bootstrap",
    srcs = glob(["src/**/*.rs"]) + ["Cargo.toml", "Cargo.lock"],
    outs = ["please_rust_bootstrap"],
    binary = True,
    # Build using cargo with the Please-managed toolchain
    cmd = """
        set -e

        # Set up environment for cargo to use our toolchain
        export CARGO_HOME=$TMP_DIR/.cargo
        export RUSTC=$TOOLS_RUSTC
        export RUSTFLAGS="--sysroot $TOOLS_SYSROOT"


        # Build release binary from the source directory
        $TOOLS_CARGO build --release --manifest-path tools/please_rust/Cargo.toml --target-dir $TMP_DIR/target 2>&1

        # Copy the binary to output
        cp $TMP_DIR/target/release/please_rust $OUTS
    """,
    sandbox = False,  # Needed for cargo to download dependencies
    # Take the toolchain from config rather than naming this repo's own: a
    # consumer building the tool from source already has a Rust toolchain, and
    # hardcoding ours made them download a second one.
    tools = {
        "rustc": [CONFIG.RUST.RUSTC],
        "sysroot": [CONFIG.RUST.SYSROOT],
        "cargo": [CONFIG.RUST.CARGO_TOOL if CONFIG.RUST.CARGO_TOOL else toolchain_entry('cargo')],
    },
    visibility = ["PUBLIC"],
)

# Version file for packaging
genrule(
    name = "version",
    srcs = ["VERSION"],
    outs = ["version.build_defs"],
    cmd = "echo PLEASE_RUST_VERSION = \\\"$(cat $SRCS)\\\" > $OUT",
    visibility = ["PUBLIC"],
)
